# =======================================================
# .env.example — Inclusão e Diversidade .NET
# =======================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores no .env
#   3. NUNCA versione o arquivo .env no Git
#      (certifique-se que .env está no .gitignore)
# =======================================================

# ==========================================
# Configuração do Aplicativo
# ==========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ==========================================
# Configuração do Banco de Dados Oracle
# ==========================================
# Dentro do Docker use "db" como host
# Fora do Docker use "localhost"
DB_HOST=db
DB_PORT=1521
DB_NAME=ORCL
DB_USER=system
ORACLE_PASSWORD=sua_senha_oracle_aqui

# ==========================================
# Configuração JWT
# Formato: NomeSecao__NomePropriedade (duplo underscore)
# ==========================================
# Gere uma chave com: openssl rand -base64 64
JwtSettings__SecretKey=sua_chave_secreta_jwt_aqui_minimo_32_caracteres
JwtSettings__Issuer=Fiap.Api.InclusaoDiversidadeEmpresas
JwtSettings__Audience=UsuariosDaApiFiap

# ==========================================
# Credenciais do Administrador
# ==========================================
AdminCredentials__Email=admin@fiap.com
AdminCredentials__Senha=sua_senha_admin_aqui

# ==========================================
# Oracle Container Registry (para o pipeline CI/CD)
# Crie conta em: https://container-registry.oracle.com
# Aceite os termos do Oracle Database Express Edition
# ==========================================
ORACLE_REGISTRY_USER=seu_email_oracle_registry
ORACLE_REGISTRY_PASSWORD=sua_senha_oracle_registry